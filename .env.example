# Numer, na który przychodzi SMS o nowej rezerwacji.
OWNER_SMS_PHONE=889599088

# Kod do panelu /wlasciciel (odmowa terminu i ponowna wysyłka SMS).
OWNER_PIN=zmien-mnie

# Dowolny długi sekret do podpisu ciasteczka panelu.
OWNER_SECRET=zmien-mnie-na-dlugi-losowy-ciag

# Adres tej strony, wstawiany do SMS-a z linkiem anulowania.
PUBLIC_URL=http://localhost:3000

# Postgres z Neon (https://console.neon.tech). Connection string z pulą (host zawiera -pooler).
# Bez tej zmiennej rezerwacje zapisują się lokalnie w data/bookings.json.
DATABASE_URL=

# smsapi (Polska, najbliższy odpowiednik Resend) albo twilio
SMS_PROVIDER=smsapi

# Token OAuth z panelu SMSAPI: https://ssl.smsapi.pl/oauth/manage
SMSAPI_TOKEN=

# Pole nadawcy. Zostaw puste, żeby użyć domyślnego z konta.
# 2way działa bez zatwierdzonej nazwy. Nazwa własna, np. SzareMiraze (max 11 znaków, bez spacji i polskich liter), musi być dodana w SMSAPI.
SMSAPI_FROM=

# Tylko gdy SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
